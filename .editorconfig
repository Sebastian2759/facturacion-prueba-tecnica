root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_diagnostic.CA5359.severity = error
dotnet_diagnostic.CA3001.severity = warning
dotnet_diagnostic.CA3002.severity = warning
dotnet_diagnostic.CA3003.severity = warning
dotnet_diagnostic.CA3004.severity = warning
dotnet_diagnostic.CA3006.severity = warning
dotnet_diagnostic.CA5364.severity = error

[*.{json,yml,yaml,ts,html,scss,css}]
indent_size = 2

[Test/**/*.cs]
# Test names follow the inherited Method_Scenario_Outcome convention.
dotnet_diagnostic.CA1707.severity = none

[Core/Application/Base/ResponseBase.cs]
# Static factories preserve the template's ResponseBase<T> API contract.
dotnet_diagnostic.CA1000.severity = none

[Core/Domain/Base/Interface/*.cs]
# Preserve the template namespace; this application does not expose a VB API.
dotnet_diagnostic.CA1716.severity = none
