<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- API versioning + API Explorer/OpenAPI integration -->
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <!-- FluentValidation is referenced here for GlobalExceptionHandler. -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <!-- JWT Bearer authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Built-in OpenAPI for .NET 10 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Direct patched version: overrides the vulnerable transitive 2.0.0. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Scalar UI for API exploration -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Application\Application.csproj" />
    <ProjectReference Include="..\..\Core\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\Infraestructure\Adapters\Adapters.csproj" />
    <ProjectReference Include="..\..\Infraestructure\Persistence\Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The local executable owns its configuration; do not copy conflicting host files. -->
    <Content Update="appsettings*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
